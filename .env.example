# Copy this file to .env and fill in your values.
# Do not commit .env to version control.

# OpenAI (required for chat)
OPENAI_API_KEY=your-openai-api-key

# Database: Supabase Postgres connection URI (required for chat storage)
# From Supabase: Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Connection pooling" URI (port 5432) or "Session mode" (port 5432). Include ?sslmode=require
DATABASE_URI=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# LangSmith (optional - for tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-agent

# Documents folder (used in Phase 2+)
# DOCUMENTS_PATH=documents
